{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "Relay": {
    "Port": 8796,
    "DataDirectory": "data",
    "HandshakeTimeoutSeconds": 30,
    "AckTimeoutSeconds": 60,
    "Hosts": [
      { "Name": "sensor", "Label": "sensor", "Password": "", "Role": "Source" },
      { "Name": "follower1", "Label": "follower1", "Password": "", "Role": "Receiver" },
      { "Name": "follower2", "Label": "follower2", "Password": "", "Role": "Receiver" }
    ],
    "StreamExport": {
      "Enabled": false,
      "Path": "data/stream.tsv",
      "Unit": "mmol/L",
      "DebounceSeconds": 5,
      "RefreshSeconds": 60
    }
  }
}
